* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary

# Lockfiles are large auto-generated diffs; keep them out of normal reviews.
package-lock.json binary

# Language hints — make GitHub stats accurate.
*.ts linguist-language=TypeScript
*.mts linguist-language=TypeScript
*.cts linguist-language=TypeScript
*.js linguist-language=JavaScript
*.mjs linguist-language=JavaScript
*.cjs linguist-language=JavaScript
*.sh linguist-language=Shell

# Generated / vendored — hide from language stats and diffs.
dist/* linguist-generated=true
coverage/* linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
